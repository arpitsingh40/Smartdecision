{
  "$schema" "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd frontend && npm ci --legacy-peer-deps && npx craco build"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/api/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}