# Copy this to /opt/smartdecision/.env (setup.sh does it automatically).
# Only MONGO_URL and DEEPSEEK_API_KEY are required for a full run.

# ---- Required ----
MONGO_URL=
DEEPSEEK_API_KEY=
JWT_SECRET=

# ---- Optional connectors (execution layer) ----
COMPOSIO_API_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=
SLACK_TOKEN=
GMAIL_ACCESS_TOKEN=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
STRIPE_API_KEY=

# ---- Configuration ----
CORS_ORIGINS=*
FRONTEND_BASE_URL=https://smartdecigen.com
DISABLE_DOCS=1
SIGNUP_CREDITS=200
TURN_COST=5
ULTRA_TURN_COST=10

# ---- Governance defaults ----
KILL_SWITCH=0
DRY_RUN=1
WEEKLY_SPEND_CAP_INR=10000