# === Required ===
# Get your free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your-gemini-api-key-here

# === Optional (with defaults) ===
JWT_SECRET=replace-with-a-random-secret
MONGO_URL=mongodb://localhost:27017/smartdecision
DB_NAME=smartdecision
CORS_ORIGINS=*
FRONTEND_BASE_URL=http://localhost:3000

# === Zoho Payments (for UPI autopay subscriptions + one-time purchases) ===
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_API_BASE=https://payments.zoho.in/api/v1
ZOHO_WEBHOOK_SECRET=

# === Firebase Auth (phone OTP login) ===
# Your Firebase project ID (from Firebase Console -> Project Settings)
FIREBASE_PROJECT_ID=smartdecigen
# Path to Firebase Admin SDK service account JSON (relative to backend/ dir)
# OR set FIREBASE_CREDENTIALS_JSON with the full JSON content as a single-line string
GOOGLE_APPLICATION_CREDENTIALS=smartdecigen-firebase-adminsdk-fbsvc-6b0a404451.json
# In production (Railway/Heroku/etc), paste the entire Firebase JSON here instead:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"smartdecigen",...}

# === Stripe (only if billing is enabled as fallback) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === AWS (only if file uploads to S3 are enabled) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
